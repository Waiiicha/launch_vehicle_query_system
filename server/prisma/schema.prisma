generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Rocket {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  series       String?  // 系列
  country      String?  // 国家
  manufacturer String?  // 研制单位 (CASC, SpaceX...)
  
  // 数值参数 (用于筛选)
  leoCapacity  Float?   // LEO运力 (吨)
  gtoCapacity  Float?   // GTO运力 (吨)
  marsCapacity Float?   // 火星运力 (吨)
  liftoffThrust Float?  // 起飞推力 (kN)
  liftoffMass   Float?  // 起飞质量 (吨)
  height        Float?  // 高度 (m)
  diameter      Float?  // 直径 (m)
  
  // 燃料与动力
  firstStageFuel  String? // 一级燃料
  secondStageFuel String? // 二级燃料
  firstStageEngine String? // 一级发动机
  
  // 状态与描述
  status       String?  // 现役/研发/退役
  firstFlight  String?  // 首飞时间
  description  String?  // 描述
  
  // 成功率统计 (如 "18发18中")
  launches     Int?     @default(0) // 总发射数
  failures     Int?     @default(0) // 失败数
  
  isReusable   Boolean  @default(false) // 是否可回收
  
  imageUrl     String?  // 图片URL (占位)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}