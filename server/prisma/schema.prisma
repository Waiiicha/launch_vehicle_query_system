generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Rocket {
  id           Int      @id @default(autoincrement())
  
  // 严格对应 Excel 列
  series       String?  // 系列
  name         String   @unique // 型号
  country      String?  // 国家
  manufacturer String?  // 研制单位
  firstFlight  String?  // 首发时间
  history      String?  // 发射历史
  status       String?  // 状态
  
  height       Float?   // 高度(m)
  diameter     Float?   // 直径(m)
  mass         Float?   // 起飞质量(t)
  stages       String?  // 构型
  boosters     String?  // 助推器配置 (新增)

  leoCapacity  Float?   // LEO运力(t)
  gtoCapacity  Float?   // GTO运力(t)
  marsCapacity Float?   // 火星运力(t)
  plutoCapacity Float?  // 冥王星运力(t)
  
  firstStageFuel   String? // 芯一级燃料
  firstStageEngine String? // 芯一级发动机配置
  firstStageThrust String? // 芯一级推力
  
  secondStageFuel   String? // 芯二级燃料
  secondStageEngine String? // 芯二级发动机配置
  secondStageThrust String? // 芯二级推力
  
  thirdStageFuel   String? // 芯三级燃料
  thirdStageEngine String? // 芯三级发动机配置
  thirdStageThrust String? // 芯三级推力
  
  recoveryMethod  String? // 回收方案
  isReusable      Boolean @default(false)
  imageUrl        String? // 图片地址

  description     String? // 核心特征和主要任务
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Engine {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  country         String?  // 国家
  manufacturer    String?
  propellant      String?
  cycle           String?
  thrust          String?
  specificImpulse String?
  description     String?
  usedBy          String?
  imageUrl        String?
  
  // 新增详细参数
  restartCount    String? // 启动次数
  weight          String? // 发动机重量
  twRatio         String? // 推重比
  throttleRange   String? // 推力调节范围
  gimbalAngle     String? // 最大摇摆角度
  clustering      String? // 现有成组方式
  neededFor750t   String? // 750t所需数量
  neededFor7500t  String? // 7500t所需数量

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
