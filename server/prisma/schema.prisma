// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Rocket {
  id           Int      @id @default(autoincrement())
  series       String?  // 系列 (长征, Falcon...)
  name         String   @unique // 型号 (CZ-5, Falcon 9...)
  country      String?  // 国家
  manufacturer String?  // 研制单位
  firstFlight  String?  // 首发时间 (存字符串以兼容 "预计2027")
  status       String?  // 状态
  height       String?  // 高度 (存字符串以保留格式，或尝试解析为浮点)
  diameter     String?  // 直径
  mass         String?  // 起飞质量
  leoCapacity  String?  // LEO运力
  gtoCapacity  String?  // GTO运力
  fuel         String?  // 燃料
  engines      String?  // 发动机
  description  String?  // 核心特征
  isReusable   Boolean  @default(false) // 是否可回收
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
